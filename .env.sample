# evals/run-all.sh 用の設定
# このファイルをコピーして .env として保存し、必要に応じて値を変更してください
# cp .env.sample .env

# --- local モード（LM Studio）---
# LM Studio のエンドポイント（デフォルト: http://127.0.0.1:1234/v1）
WAZA_LOCAL_LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM Studio でロードするモデル名
WAZA_LOCAL_MODEL=gemma-4-e4b-it-mlx

# --- claude モード（Anthropic API を BYOK で利用）---
# Claude Console で発行した API キー（Max プランの月次 API クレジットを使う場合は Console の組織をプランに紐づけておく）
ANTHROPIC_API_KEY=
# 使うモデル（既定: claude-haiku-5-5）。失敗した eval は同じモデルで 1 回だけ再試行する。強いモデルへの昇格はしない
WAZA_CLAUDE_MODEL=claude-haiku-5-5
# claude モードで使う Copilot CLI の実行ファイル。未指定なら evals/.copilot-cli/ に入れたものを使う
# （bash evals/install-copilot-cli.sh で導入。waza 同梱の 1.0.85 は Haiku 5.5 で 400 になる）
COPILOT_CLI_PATH=
